# Password required only for enrolling faces (via web dashboard or POST /api/enroll)
# The web dashboard, camera stream, logs, telemetry, and health check require no login password.
ENROLLMENT_PASSWORD=123456789
ADMIN_ENROLLMENT_TOKEN=123456789

# auto, picamera2, opencv, or synthetic
CAMERA_BACKEND=auto
# USB camera device index (used by OpenCV)
CAMERA_INDEX=0
